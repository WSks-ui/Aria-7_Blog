---
import { Picture } from "astro:assets";
import ariaAvatar from "../assets/images/aria-avatar.webp";
import SiteFooter from "../components/SiteFooter.astro";
import NavBar from "../components/NavBar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Me" description="Aria-7th Lab 的个人介绍。" bodyClass="inner-page">
  <NavBar compact />
  <main id="main-content" class="page-frame" tabindex="-1">
    <section class="profile-panel profile-panel--simple glass-panel">
      <div class="profile-avatar" aria-hidden="true">
        <Picture
          src={ariaAvatar}
          alt=""
          widths={[160, 256, 512]}
          sizes="(max-width: 720px) 128px, 224px"
          formats={["avif", "webp"]}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <p class="eyebrow">ME / PROFILE</p>
        <h1>Aria-7</h1>
        <p>
          06 年，大学生。这里主要放学习记录、项目复盘和一点日常想法。
        </p>
        <div class="tag-row">
          <span>Aria-7</span>
          <span>ACGN</span>
          <span>Frontend</span>
          <span>AI 绘图</span>
          <span>Linux</span>
        </div>
      </div>
    </section>
    <SiteFooter />
  </main>
</BaseLayout>
