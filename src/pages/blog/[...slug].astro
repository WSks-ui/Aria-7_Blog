---
import { render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import {
  getAdjacentPosts,
  getRelatedPosts,
  getSeriesPosts,
  getSiteCatalog,
} from "../../utils/siteCatalog";

export async function getStaticPaths() {
  const catalog = await getSiteCatalog();

  return catalog.posts.map(({ post }) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const catalog = await getSiteCatalog();
const current = catalog.posts.find((entry) => entry.id === post.id);
if (!current) throw new Error(`公开文章“${post.id}”未出现在 SiteCatalog 中`);

const articleStats = {
  ...catalog.stats,
  latestActivityDate: catalog.stats.latestActivityDate.toISOString(),
};
const adjacentPosts = getAdjacentPosts(catalog, current);
const seriesPosts = getSeriesPosts(catalog, current);
const relatedPosts = getRelatedPosts(catalog, current);
---

<PostLayout
  {...post.data}
  words={current.metrics.words}
  minutes={current.metrics.minutes}
  toc={headings}
  stats={articleStats}
  previousPost={adjacentPosts.previous}
  nextPost={adjacentPosts.next}
  seriesPosts={seriesPosts}
  relatedPosts={relatedPosts}
>
  <Content />
</PostLayout>
