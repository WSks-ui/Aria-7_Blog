---
import {
  BookOpen,
  CalendarDays,
  ChevronRight,
  Folder,
  Hash,
  House,
} from "@lucide/astro";
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostCoverAsset } from "../assets/post-covers";
import NavBar from "./NavBar.astro";
import SiteFooter from "./SiteFooter.astro";
import { readSiteImageDimensions } from "../lib/images";
import type { CatalogTerm } from "../utils/siteCatalog";
import "../styles/blog.css";

interface Props {
  kind: "tag" | "category";
  term: CatalogTerm;
  relatedTerms: CatalogTerm[];
}

const { kind, term, relatedTerms } = Astro.props;
const kindLabel = kind === "tag" ? "标签" : "分类";
const titlePrefix = kind === "tag" ? "#" : "";
const description = `${kindLabel}“${term.label}”下共有 ${term.count} 篇公开文章。`;
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "Asia/Shanghai",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const coverDimensions = new Map(await Promise.all(term.posts.map(async (entry) => [
  entry.id,
  entry.post.data.cover ? await readSiteImageDimensions(entry.post.data.cover) : null,
] as const)));
---

<BaseLayout
  title={`${titlePrefix}${term.label} · ${kindLabel}归档`}
  description={description}
  bodyClass="inner-page blog-list-page archive-page"
>
  <NavBar compact />
  <main class="page-frame blog-frame">
    <header class="archive-header glass-panel">
      <div class="archive-header__eyebrow">
        {kind === "tag" ? <Hash size={18} aria-hidden="true" /> : <Folder size={18} aria-hidden="true" />}
        <span>{kind === "tag" ? "TAG ARCHIVE" : "CATEGORY ARCHIVE"}</span>
      </div>
      <h1>{titlePrefix}{term.label}</h1>
      <p>{description}</p>
      <nav class="archive-header__links" aria-label={`${kindLabel}归档导航`}>
        <a href="/blog/"><House size={16} aria-hidden="true" />全部文章</a>
        {relatedTerms.slice(0, 10).map((related) => (
          <a href={`/blog/${kind === "tag" ? "categories" : "tags"}/${related.slug}/`}>
            {kind === "tag" ? <Folder size={15} aria-hidden="true" /> : <Hash size={15} aria-hidden="true" />}
            {related.label}
            <small>{related.count}</small>
          </a>
        ))}
      </nav>
    </header>

    <section class="post-grid archive-post-grid" aria-label={`${term.label}文章列表`}>
      {term.posts.map((entry) => {
        const coverAsset = getPostCoverAsset(entry.post.data.cover);
        return (
        <article class={`post-card glass-panel ${entry.post.data.cover ? "post-card--with-preview" : ""}`}>
          <a href={`/blog/${entry.id}/`} aria-label={`阅读 ${entry.title}`}>
            <div class="post-card__content">
              <span class="post-card__marker" aria-hidden="true"></span>
              <h2>{entry.title}</h2>
              <div class="post-card__meta">
                <span>
                  <CalendarDays size={18} aria-hidden="true" />
                  <time datetime={entry.pubDate.toISOString()}>{dateFormatter.format(entry.pubDate)}</time>
                </span>
                <span>
                  <BookOpen size={18} aria-hidden="true" />
                  {entry.category}
                </span>
              </div>
              <p>{entry.description}</p>
              <div class="tag-row">
                {entry.tags.map((tag) => <span>#{tag}</span>)}
              </div>
            </div>
            {
              entry.post.data.cover ? (
                <figure class="post-card__preview" aria-hidden="true">
                  {
                    coverAsset ? (
                      <Picture
                        src={coverAsset}
                        alt=""
                        widths={[320, 480, 768]}
                        sizes="(max-width: 720px) calc(100vw - 48px), 320px"
                        formats={["avif", "webp"]}
                        fallbackFormat="webp"
                        loading="lazy"
                        decoding="async"
                        fetchpriority="low"
                      />
                    ) : (
                      <img
                        src={entry.post.data.cover}
                        alt=""
                        width={coverDimensions.get(entry.id)?.width}
                        height={coverDimensions.get(entry.id)?.height}
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  }
                  <span><ChevronRight size={28} /></span>
                </figure>
              ) : (
                <div class="post-card__rail" aria-hidden="true">
                  <ChevronRight size={34} />
                </div>
              )
            }
          </a>
        </article>
        );
      })}
    </section>
    <SiteFooter />
  </main>
</BaseLayout>
