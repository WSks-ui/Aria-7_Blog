{
  "name": "aria-7th-lab-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:links:external": "node scripts/check-external-links.mjs",
    "check:performance": "node scripts/check-performance-budgets.mjs",
    "fetch:contributions": "node scripts/fetch-github-contributions.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@lucide/astro": "1.25.0",
    "astro": "7.1.1",
    "chess.js": "^1.4.0",
    "image-size": "2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "undici": "^8.9.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "overrides": {
    "@astrojs/language-server": "2.16.13",
    "brace-expansion": "5.0.8",
    "fast-uri": "4.1.1",
    "sharp": "0.35.3",
    "svgo": "4.0.2",
    "tmp": "0.2.7"
  },
  "description": "Aria-7th Lab：使用 Astro 构建的静态个人博客与实验空间。",
  "keywords": [
    "astro",
    "blog",
    "static-site",
    "aria-7th-lab",
    "personal-site"
  ],
  "author": "WSks-ui",
  "license": "MIT"
}
